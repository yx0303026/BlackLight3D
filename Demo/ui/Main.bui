<?xml version="1.0" encoding="UTF-8"?>
<bui>
  <styles>
    html, body {
      display: block;
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      font-family: Arial;
      font-size: 15dp;
      color: #173844;
      background-color: transparent;
    }

    div { display: block; box-sizing: border-box; }

    .hud {
      position: absolute;
      left: 18dp;
      top: 18dp;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 10dp;
      padding: 9dp 12dp;
      background-color: #f6f3e7;
      border: 2dp #173844;
    }

    .hud-title {
      color: #173844;
      font-size: 17dp;
      font-weight: bold;
      padding-right: 8dp;
    }

    .hud-value {
      color: #173844;
      font-weight: bold;
      background-color: #f4c66d;
      padding: 5dp 8dp;
    }

    .help {
      position: absolute;
      right: 18dp;
      top: 18dp;
      padding: 8dp 11dp;
      background-color: #f6f3e7;
      border: 2dp #173844;
      color: #173844;
    }

    .overlay {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: rgba(18, 43, 53, 0.64);
    }

    .panel {
      width: 390dp;
      padding: 28dp;
      background-color: #f6f3e7;
      border: 4dp #173844;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .title {
      color: #173844;
      font-size: 34dp;
      font-weight: bold;
      margin-bottom: 10dp;
    }

    .subtitle {
      color: #345963;
      font-size: 17dp;
      margin-bottom: 18dp;
      text-align: center;
    }

    button {
      color: #ffffff;
      background-color: #e3654f;
      border: 2dp #a8433a;
      padding: 11dp 24dp;
      font-size: 17dp;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover { background-color: #f08061; }
    button:active { background-color: #bd4f45; }
    .hidden { display: none; }

    .footer {
      position: absolute;
      left: 18dp;
      bottom: 16dp;
      display: flex;
      flex-direction: row;
      gap: 9dp;
    }

    .footer-item {
      background-color: #f6f3e7;
      border: 2dp #173844;
      padding: 6dp 9dp;
      color: #173844;
      font-size: 12dp;
    }
  </styles>

  <layout>
    <div id="hud" class="hud">
      <div class="hud-title">CLOUD HOP</div>
      <div class="hud-value">COINS <span id="score_value">0</span>/7</div>
      <div class="hud-value">LIVES <span id="lives_value">3</span></div>
      <div class="hud-value" id="status_value">READY</div>
    </div>
    <div class="help">A / D or arrows to move | Space to jump | Esc to pause</div>
    <div class="footer">
      <div class="footer-item">FPS <span id="fps_value">0</span></div>
      <div class="footer-item">CPU <span id="frame_value">0 ms</span></div>
      <div class="footer-item">GPU <span id="gpu_value">0 ms</span></div>
      <div class="footer-item">DRAW <span id="draw_value">0</span></div>
      <div class="footer-item">VERT <span id="vertex_value">0</span></div>
      <div class="footer-item">SWAP <span id="texture_value">0</span></div>
    </div>
    <div id="start_panel" class="overlay">
      <div class="panel">
        <div class="title">CLOUD HOP</div>
        <div class="subtitle">Find the seven sun coins, dodge the coral spikes, and reach the beacon.</div>
        <button id="start_button">START GAME</button>
      </div>
    </div>
    <div id="pause_panel" class="overlay hidden">
      <div class="panel">
        <div class="title">PAUSED</div>
        <div class="subtitle">Press Escape to keep climbing.</div>
      </div>
    </div>
    <div id="game_over_panel" class="overlay hidden">
      <div class="panel">
        <div class="title">TRY AGAIN</div>
        <div class="subtitle">The climb is still yours. Press R or restart below.</div>
        <button id="retry_button">RESTART</button>
      </div>
    </div>
    <div id="win_panel" class="overlay hidden">
      <div class="panel">
        <div class="title">NICE CLIMB!</div>
        <div class="subtitle">You reached the beacon. Press R to play another round.</div>
        <button id="play_again_button">PLAY AGAIN</button>
      </div>
    </div>
  </layout>
</bui>
