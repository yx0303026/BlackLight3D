<?xml version="1.0" encoding="UTF-8"?>
<bui>
  <styles>
    html, body {
      display: block;
      width: 100%;
      height: 100%;
      font-family: Arial;
      font-size: 12dp;
      color: #f4f6f8;
      margin: 0;
      padding: 0;
      background-color: #263746;
    }

    div {
      display: block;
      box-sizing: border-box;
    }

    button {
      color: #ffffff;
      background-color: #326b8c;
      padding: 7dp 12dp;
      margin: 4dp;
      cursor: pointer;
      border-width: 0;
      border-radius: 3dp;
    }

    button:hover {
      background-color: #3f829f;
    }

    button:active {
      background-color: #24536e;
    }

    .main-screen {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      gap: 0;
    }

    .title-panel {
      display: flex;
      flex-direction: row;
      background-color: #1e2c37;
      padding: 16dp;
      gap: 12dp;
      align-items: center;
      border-bottom: 2dp #3a4a52;
    }

    .title-text {
      display: block;
      font-size: 24dp;
      font-weight: bold;
      color: #2ecc71;
      flex: 1;
    }

    .content-panel {
      display: flex;
      flex-direction: row;
      flex: 1;
      gap: 12dp;
      padding: 12dp;
      overflow: hidden;
    }

    .panel-half {
      display: flex;
      flex-direction: column;
      flex: 1;
      background-color: #2a3a42;
      border: 1dp #3a4a52;
      border-radius: 4dp;
      padding: 12dp;
      overflow: hidden;
    }

    .panel-title {
      display: block;
      font-size: 14dp;
      font-weight: bold;
      color: #2ecc71;
      margin-bottom: 8dp;
      padding-bottom: 8dp;
      border-bottom: 1dp #3a4a52;
    }

    .list-box {
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: 4dp;
      overflow-y: auto;
    }

    .list-item {
      display: block;
      padding: 8dp;
      background-color: #34495e;
      color: #ecf0f1;
      border-radius: 2dp;
      cursor: pointer;
    }

    .list-item:hover {
      background-color: #3f5268;
      color: #2ecc71;
    }

    .grid-container {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      flex: 1;
      gap: 8dp;
      overflow-y: auto;
    }

    .grid-item {
      display: flex;
      flex-direction: column;
      width: 60dp;
      height: 60dp;
      background-color: #34495e;
      border: 1dp #3a4a52;
      border-radius: 4dp;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .grid-item:hover {
      background-color: #3f5268;
      border-color: #2ecc71;
    }

    .status-bar {
      display: flex;
      flex-direction: row;
      background-color: #1e2c37;
      padding: 8dp 12dp;
      gap: 12dp;
      border-top: 1dp #3a4a52;
      height: 32dp;
      align-items: center;
    }

    .status-item {
      display: block;
      color: #ecf0f1;
      font-size: 12dp;
      flex: 1;
    }
  </styles>

  <layout>
    <div id="main_screen" class="main-screen">
      <!-- Title Panel -->
      <div id="title_panel" class="title-panel">
        <div class="title-text">Welcome to BlackLight3D</div>
        <button id="start_button">Start</button>
      </div>

      <!-- Content Panel -->
      <div id="content_panel" class="content-panel">
        <!-- Left Panel: Assets List -->
        <div id="left_panel" class="panel-half">
          <div class="panel-title">Assets Library</div>
          <div id="assets_list" class="list-box">
            <div class="list-item">Textures</div>
            <div class="list-item">Models</div>
            <div class="list-item">Animations</div>
            <div class="list-item">Shaders</div>
            <div class="list-item">Sounds</div>
          </div>
        </div>

        <!-- Right Panel: Asset Details -->
        <div id="right_panel" class="panel-half">
          <div class="panel-title">Asset Details</div>
          <div id="asset_grid" class="grid-container">
            <div class="grid-item"><span>T1</span></div>
            <div class="grid-item"><span>T2</span></div>
            <div class="grid-item"><span>T3</span></div>
            <div class="grid-item"><span>T4</span></div>
            <div class="grid-item"><span>M1</span></div>
            <div class="grid-item"><span>M2</span></div>
            <div class="grid-item"><span>M3</span></div>
            <div class="grid-item"><span>M4</span></div>
          </div>
        </div>
      </div>

      <!-- Status Bar -->
      <div id="status_bar" class="status-bar">
        <div class="status-item">Ready</div>
        <div class="status-item">FPS: 60</div>
        <div class="status-item">Geometry: 0 tri</div>
      </div>
    </div>
  </layout>
</bui>
