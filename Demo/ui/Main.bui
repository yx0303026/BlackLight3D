<?xml version="1.0" encoding="UTF-8"?>
<bui>
  <styles>
    html, body {
      display: block;
      width: 100%;
      height: 100%;
      font-family: Arial;
      color: #f4f6f8;
      margin: 0;
      padding: 0;
      background-color: #263746;
    }

    div {
      display: block;
      box-sizing: border-box;
    }

    button {
      color: #ffffff;
      background-color: #326b8c;
      padding: 7px 12px;
      margin: 4px;
      cursor: pointer;
      border: none;
      border-radius: 3px;
    }

    button:hover {
      background-color: #3f829f;
    }

    button:active {
      background-color: #24536e;
    }

    .main-screen {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: 100%;
      gap: 0;
    }

    .title-panel {
      display: flex;
      flex-direction: row;
      background-color: #1e2c37;
      padding: 16px;
      gap: 12px;
      align-items: center;
      border-bottom: 2px solid #3a4a52;
    }

    .title-text {
      display: block;
      font-size: 24px;
      font-weight: bold;
      color: #2ecc71;
      flex: 1;
    }

    .content-panel {
      display: flex;
      flex-direction: row;
      flex: 1;
      gap: 12px;
      padding: 12px;
      overflow: hidden;
    }

    .panel-half {
      display: flex;
      flex-direction: column;
      flex: 1;
      background-color: #2a3a42;
      border: 1px solid #3a4a52;
      border-radius: 4px;
      padding: 12px;
      overflow: hidden;
    }

    .panel-title {
      display: block;
      font-size: 14px;
      font-weight: bold;
      color: #2ecc71;
      margin-bottom: 8px;
      padding-bottom: 8px;
      border-bottom: 1px solid #3a4a52;
    }

    .list-box {
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: 4px;
      overflow-y: auto;
    }

    .list-item {
      display: block;
      padding: 8px;
      background-color: #34495e;
      color: #ecf0f1;
      border-radius: 2px;
      cursor: pointer;
    }

    .list-item:hover {
      background-color: #3f5268;
      color: #2ecc71;
    }

    .grid-container {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      flex: 1;
      gap: 8px;
      overflow-y: auto;
    }

    .grid-item {
      display: flex;
      flex-direction: column;
      width: 60px;
      height: 60px;
      background-color: #34495e;
      border: 1px solid #3a4a52;
      border-radius: 4px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .grid-item:hover {
      background-color: #3f5268;
      border-color: #2ecc71;
    }

    .status-bar {
      display: flex;
      flex-direction: row;
      background-color: #1e2c37;
      padding: 8px 12px;
      gap: 12px;
      border-top: 1px solid #3a4a52;
      height: 32px;
      align-items: center;
    }

    .status-item {
      display: block;
      color: #ecf0f1;
      font-size: 12px;
      flex: 1;
    }
  </styles>

  <layout>
    <div id="main_screen" class="main-screen">
      <!-- Title Panel -->
      <div id="title_panel" class="title-panel">
        <div class="title-text">Welcome to BlackLight3D</div>
        <button id="start_button">Start</button>
      </div>

      <!-- Content Panel -->
      <div id="content_panel" class="content-panel">
        <!-- Left Panel: Assets List -->
        <div id="left_panel" class="panel-half">
          <div class="panel-title">Assets Library</div>
          <div id="assets_list" class="list-box">
            <div class="list-item">📁 Textures</div>
            <div class="list-item">📁 Models</div>
            <div class="list-item">📁 Animations</div>
            <div class="list-item">📁 Shaders</div>
            <div class="list-item">📁 Sounds</div>
          </div>
        </div>

        <!-- Right Panel: Asset Details -->
        <div id="right_panel" class="panel-half">
          <div class="panel-title">Asset Details</div>
          <div id="asset_grid" class="grid-container">
            <div class="grid-item">T1</div>
            <div class="grid-item">T2</div>
            <div class="grid-item">T3</div>
            <div class="grid-item">T4</div>
            <div class="grid-item">M1</div>
            <div class="grid-item">M2</div>
            <div class="grid-item">M3</div>
            <div class="grid-item">M4</div>
          </div>
        </div>
      </div>

      <!-- Status Bar -->
      <div id="status_bar" class="status-bar">
        <div class="status-item">Ready</div>
        <div class="status-item">FPS: 60</div>
        <div class="status-item">Geometry: 0 tri</div>
      </div>
    </div>
  </layout>
</bui>
